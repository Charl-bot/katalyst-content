{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katalyst.audio/schemas/kif-v1.schema.json",
  "title": "Katalyst Instrument Format (KIF) v1 instrument definition",
  "description": "One sampled instrument: zones that map MIDI input to FLAC samples. Paths are relative to the folder holding this file. See docs/content/KIF_V1.md (D-190).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kif",
    "id",
    "version",
    "name",
    "category",
    "pitched",
    "licence",
    "audio",
    "gain_db",
    "envelope",
    "mics",
    "mic_presets",
    "articulations",
    "zones",
    "samples",
    "provenance"
  ],
  "properties": {
    "kif": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "category": {
      "enum": [
        "piano",
        "keys",
        "organ",
        "strings",
        "brass",
        "woodwinds",
        "mallets",
        "percussion",
        "drums",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "pitched": {
      "type": "boolean",
      "description": "False for kits and unpitched percussion: zones play at their recorded pitch and pitch QA is skipped."
    },
    "pack": {
      "type": "string",
      "description": "The download pack (D-191) that carries this instrument's samples."
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "verdict"],
      "properties": {
        "spdx": {
          "enum": ["CC0-1.0", "LicenseRef-Katalyst-Owned"]
        },
        "verdict": {
          "const": "GREEN"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sample_rate", "channels"],
      "properties": {
        "format": {
          "const": "flac"
        },
        "sample_rate": {
          "type": "integer",
          "enum": [44100, 48000, 88200, 96000]
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "bit_depths": {
          "type": "array",
          "items": {
            "enum": [16, 24]
          },
          "uniqueItems": true
        }
      }
    },
    "gain_db": {
      "type": "number",
      "minimum": -60,
      "maximum": 40,
      "description": "Instrument output gain from loudness normalisation; applied by the sampler, so sample PCM stays bit-exact to the source."
    },
    "loudness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "target_lufs": {
          "type": "number"
        },
        "reference_lufs": {
          "type": ["number", "null"]
        },
        "peak_dbfs_after_gain": {
          "type": ["number", "null"]
        },
        "limited_by_peak": {
          "type": "boolean"
        }
      }
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "velocity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = velocity does not change level, 1 = full (SFZ amp_veltrack 100)."
        }
      }
    },
    "polyphony": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "pitch_bend_semitones": {
      "type": "number",
      "minimum": 0,
      "maximum": 48
    },
    "mics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "name": {
            "type": "string"
          },
          "pan_width": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "mic_presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "gains_db"],
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "gains_db": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "null"],
              "description": "null = mic off (its streams are not opened)."
            }
          }
        }
      }
    },
    "articulations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "name": {
            "type": "string"
          },
          "keyswitch": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 127
          },
          "default": {
            "type": "boolean"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cc", "name"],
        "properties": {
          "cc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "name": {
            "type": "string"
          },
          "default": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        }
      }
    },
    "key_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": {
            "$ref": "#/$defs/midi"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["upstream-sfz", "katalyst-recording"]
        },
        "library": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "audio_commit": {
          "$ref": "#/$defs/commit"
        },
        "mapping_commit": {
          "$ref": "#/$defs/commit"
        },
        "sfz": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recording_session": {
          "type": "string",
          "description": "Auto-sampler session id (katalyst-recording)."
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Performer / venue release document ids (katalyst-recording)."
        },
        "converter": {
          "type": "string"
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "choke_triggers": {
      "type": "array",
      "description": "Silent triggers: a note-on matching the key range and CC conditions emits 'group', choking voices whose choked_by equals it (converted SFZ *silence regions, e.g. the hi-hat pedal muting the open hat).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_lo", "key_hi", "group"],
        "properties": {
          "key_lo": {
            "$ref": "#/$defs/midi"
          },
          "key_hi": {
            "$ref": "#/$defs/midi"
          },
          "group": {
            "type": "integer",
            "minimum": 1
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cc", "lo", "hi"],
              "properties": {
                "cc": {
                  "$ref": "#/$defs/midi"
                },
                "lo": {
                  "$ref": "#/$defs/midi"
                },
                "hi": {
                  "$ref": "#/$defs/midi"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 48
    },
    "midi": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "decay", "sustain", "release"],
      "properties": {
        "attack": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "sustain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Linear level 0..1."
        },
        "release": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_lo", "key_hi", "vel_lo", "vel_hi", "layers"],
      "properties": {
        "key_lo": {
          "$ref": "#/$defs/midi"
        },
        "key_hi": {
          "$ref": "#/$defs/midi"
        },
        "root": {
          "type": ["integer", "null"],
          "minimum": -127,
          "maximum": 254,
          "description": "MIDI note recorded; null = no pitch tracking."
        },
        "vel_lo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "vel_hi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "vel_xfade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "out": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "articulation": {
          "type": ["string", "null"]
        },
        "trigger": {
          "enum": ["attack", "release"]
        },
        "rr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["sequence", "random"]
            },
            "group": {
              "type": "string"
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "length": {
              "type": "integer",
              "minimum": 1
            },
            "lo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hi": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cc", "lo", "hi"],
            "properties": {
              "cc": {
                "$ref": "#/$defs/midi"
              },
              "lo": {
                "$ref": "#/$defs/midi"
              },
              "hi": {
                "$ref": "#/$defs/midi"
              }
            }
          }
        },
        "tune_cents": {
          "type": "number",
          "minimum": -2400,
          "maximum": 2400
        },
        "gain_db": {
          "type": "number",
          "minimum": -144,
          "maximum": 72,
          "description": "Per-zone gain carried from the upstream mapping (SFZ volume). VCSL boosts quiet takes by up to ~57 dB."
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "amp_veltrack": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Start frame inside the (trimmed) sample."
        },
        "loop": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["mode", "start", "end"],
          "properties": {
            "mode": {
              "enum": ["continuous", "sustain"]
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "description": "Inclusive last frame."
            },
            "crossfade": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "one_shot": {
          "type": "boolean",
          "description": "Play to the end regardless of note-off (drums)."
        },
        "release_decay_db_per_s": {
          "type": "number",
          "minimum": 0,
          "description": "Release-trigger attenuation by how long the key was held (SFZ rt_decay)."
        },
        "choke_group": {
          "type": "integer",
          "minimum": 1
        },
        "choked_by": {
          "type": "integer",
          "minimum": 1
        },
        "choke_time": {
          "type": "number",
          "minimum": 0
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "description": "Samples started together, sample-aligned (one per mic for multi-mic instruments).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sample", "mic"],
            "properties": {
              "sample": {
                "type": "string"
              },
              "mic": {
                "$ref": "#/$defs/ident"
              }
            }
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "sha256",
        "bytes",
        "frames",
        "channels",
        "sample_rate",
        "bit_depth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "file": {
          "type": "string",
          "pattern": "^samples/[A-Za-z0-9_.-]+\\.flac$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "sample_rate": {
          "type": "integer"
        },
        "bit_depth": {
          "enum": [16, 24]
        },
        "preload_frames": {
          "type": "integer",
          "minimum": 0,
          "description": "Frames to keep resident so a voice can start before the disk stream arrives."
        },
        "peak_dbfs": {
          "type": "number"
        },
        "tail_rms_dbfs": {
          "type": "number",
          "description": "RMS of the last 100 ms (noise floor / decay), QA only."
        },
        "measured_pitch_cents": {
          "type": ["number", "null"],
          "description": "Detected pitch relative to the zone root + tune (QA only; not applied)."
        },
        "trimmed_frames": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string"
            },
            "git_blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer"
            },
            "format": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
