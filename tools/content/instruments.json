      "instruments": [
        {
          "id": "flemish-harpsichord",
          "name": "Flemish Harpsichord",
          "category": "keys",
          "description": "Two-manual style harpsichord: 8' and 4' stops and both together, with key-release (jack) samples.",
          "qa_notes": [
            "The 4' stop sounds an octave above the key by design (that is what a 4' register is); its octave suspects in this report are expected. Measured: 16 of the 4' samples sit +12 semitones above their key, the rest were not measurable unguided."
          ],
          "parts": [
            {
              "sfz": "Chordophones/Zithers/Harpsichord, Flemish - Keyswitch.sfz"
            }
          ],
          "articulations": [
            {
              "id": "full",
              "name": "8' + 4'",
              "match": "full",
              "default": true
            },
            { "id": "stop-8", "name": "8'", "match": "8'" },
            { "id": "stop-4", "name": "4'", "match": "4'" }
          ]
        }
      ]
    },
